# =========================================================
# Nextcloud stack - environment template
# Copy file ini menjadi ".env" lalu isi semua value di bawah.
# JANGAN commit file ".env" (sudah ada .gitignore untuk ini).
# =========================================================

# --- Domain ---
NEXTCLOUD_TRUSTED_DOMAINS=cloud.motorsights.com

# --- Reverse proxy (existing / global) ---
# Nama Docker network eksternal milik reverse proxy global yang sudah
# berjalan di server (mis. "proxy", "nginx-proxy", "traefik-public").
# Jalankan `docker network ls` di server untuk melihat nama networknya.
PROXY_NETWORK_NAME=proxy

# Subnet / IP dari container reverse proxy tsb, dipakai Nextcloud untuk
# TRUSTED_PROXIES agar HTTPS terdeteksi benar di belakang proxy.
# Bisa diisi subnet Docker network proxy (mis. 172.20.0.0/16) atau IP
# spesifik container reverse proxy.
TRUSTED_PROXIES=172.20.0.0/16

# --- Database (MariaDB) ---
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme_db_password

# --- Redis ---
REDIS_PASSWORD=changeme_redis_password

# --- Nextcloud admin (dipakai hanya saat instalasi pertama kali) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_admin_password

# --- PHP limits (untuk upload file besar) ---
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_LIMIT=10G
